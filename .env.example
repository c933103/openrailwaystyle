# Optional Node OAuth/Google tile gateway; the static site builds with none of these.
# APP_URL is the HTTPS origin of this backend (not the Pages frontend).
APP_URL=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_ADMIN_REPO=c933103/openrailwaystyle
SESSION_SECRET=
# Private server-side Map Tiles API key. Never copy into the Pages deployment.
GOOGLE_MAPS_PLATFORM_API_KEY=
# Optional separate referrer-restricted Maps JavaScript API browser key (public).
GOOGLE_MAPS_BROWSER_API_KEY=
# Local development only: opt into the supplied GitHub App Manifest bootstrap.
ATLAS_ALLOW_GITHUB_APP_BOOTSTRAP=0
