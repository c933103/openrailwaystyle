  "url_grammar": {
    "description": "Bounded ASCII HTTP(S) URIs. IDNs use punycode; non-ASCII components use percent encoding. DNS names, canonical IPv4 and bracketed IPv6 are supported; no DNS or network lookup.",
    "pattern": "https?://(?:(?:[A-Za-z0-9._~!$&'()*+,;=:%-]+)@)?(\\[[0-9A-Fa-f:.]+\\]|[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*\\.?)(?::([0-9]{1,5}))?(?:[/?#][A-Za-z0-9._~!$&'()*+,;=:@/?#%\\[\\]-]*)?",
    "label_pattern": "[A-Za-z0-9_](?:[A-Za-z0-9_-]{0,61}[A-Za-z0-9_])?",
    "numeric_label_pattern": "(?:[0-9]+|0[xX][0-9A-Fa-f]+)",
    "max_length": 4096,
    "max_host_length": 253,
    "max_port": 65535,
    "max_query_fields": 128
  },
